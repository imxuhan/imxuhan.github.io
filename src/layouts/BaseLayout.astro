---
import "../styles/global.css";

interface Props {
  title?: string;
  locale?: "en" | "zh";
  alternatePath?: string;
}

const { title, locale = "en", alternatePath = locale === "zh" ? "../" : "./zh/" } = Astro.props;
const isZh = locale === "zh";
const siteName = isZh ? "徐晗" : "Xu Han";
const pageTitle = title ? `${title} · ${siteName}` : siteName;
const depth = Astro.url.pathname.split("/").filter(Boolean).length;
const localeHome = isZh
  ? depth <= 1 ? "./" : "../".repeat(depth - 1)
  : depth === 0 ? "./" : "../".repeat(depth);
---

<!doctype html>
<html lang={isZh ? "zh-CN" : "en"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <div class="shell">
      <header class="site-header">
        <a class="brand" href={localeHome}>{siteName}</a>
        <a class="lang" href={alternatePath} lang={isZh ? "en" : "zh-CN"}>{isZh ? "EN" : "中文"}</a>
      </header>
      <main>
        <slot />
      </main>
      <footer class="site-footer">© 2026 {siteName}</footer>
    </div>
  </body>
</html>
