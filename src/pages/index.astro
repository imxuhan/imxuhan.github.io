---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPosts, formatDate } from "../lib/posts";

const posts = await getPosts("en");
---

<BaseLayout alternatePath="./zh/">
  <section class="about">
    <h1>About Me</h1>
    <p>Into anything beautiful.</p>
    <p>I am an SoC engineer, mostly working on the memory subsystem.</p>
  </section>

  <section class="posts">
    <h2>Posts</h2>
    {posts.length === 0 ? (
      <p class="empty">Nothing here yet.</p>
    ) : (
      <ul class="post-list">
        {posts.map((post) => (
          <li>
            <a href={`./blog/${post.slug}/`}>{post.data.title}</a>
            <time datetime={post.data.date.toISOString().slice(0, 10)}>{formatDate(post.data.date, "en")}</time>
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>
