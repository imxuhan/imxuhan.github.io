---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPosts, formatDate } from "../../lib/posts";

const posts = await getPosts("zh");
---

<BaseLayout locale="zh" alternatePath="../">
  <section class="about">
    <h1>About Me</h1>
    <p>Into anything beautiful.</p>
    <p>我是一个 SoC engineer，主要从事 memory subsystem。</p>
  </section>

  <section class="posts">
    <h2>文章</h2>
    {posts.length === 0 ? (
      <p class="empty">还没有文章。</p>
    ) : (
      <ul class="post-list">
        {posts.map((post) => (
          <li>
            <a href={`./blog/${post.slug}/`}>{post.data.title}</a>
            <time datetime={post.data.date.toISOString().slice(0, 10)}>{formatDate(post.data.date, "zh")}</time>
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>
